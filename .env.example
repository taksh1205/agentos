# Local offline demo: no paid credentials. Never use this token for shared hosting.
AUTH_MODE=demo
DEPLOYMENT=local
API_KEYS={"local-demo-token":{"workspace":"demo","role":"admin"}}
DATABASE_URL=sqlite:///agentos.db
CHECKPOINT_PATH=checkpoints.db
# PostgreSQL application + graph persistence:
# DATABASE_URL=postgresql+psycopg://agentos:change-me@localhost/agentos
# CHECKPOINT_DATABASE_URL=postgresql://agentos:change-me@localhost/agentos
POSTGRES_PASSWORD=local-only-change-me
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-sonnet-4-5
# Optional trusted compatible endpoint; never client-selected.
# OPENAI_BASE_URL=https://your-approved-endpoint/v1
# MODEL_FALLBACKS={"primary-model":["fallback-model"]}
MODEL_MAX_OUTPUT_TOKENS=1800
MAX_TOKENS=120000
# Price units are USD per million tokens. Supply current provider prices yourself.
# MODEL_PRICES={"your-model":{"input":0.0,"output":0.0}}
# MAX_COST_USD=1
# Neural is the intended AI retrieval experience; hashing is the offline fallback.
EMBEDDING_BACKEND=hashing
# EMBEDDING_BACKEND=neural
# RETRIEVAL_METHOD=dense
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_REVISION=<pinned-model-commit>
# RERANK_MODEL=cross-encoder/ms-marco-TinyBERT-L-2-v2
# RERANK_REVISION=<pinned-model-commit>
MEMORY_TTL_DAYS=30
USE_MCP=false
MCP_TIMEOUT_SECONDS=40
REQUESTS_PER_MINUTE=120
# Shared hosting requires signed authentication:
# AUTH_MODE=oidc
# DEPLOYMENT=shared
# OIDC_ISSUER=https://your-trusted-issuer
# OIDC_AUDIENCE=agentos
# OIDC_JWKS_URL=https://your-trusted-issuer/.well-known/jwks.json
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
