  "components": {
    "schemas": {
      "Body_upload_documents_upload_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_documents_upload_post"
      },
      "Decision": {
        "properties": {
          "approve": {
            "type": "boolean",
            "title": "Approve"
          },
          "proposal_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Proposal Id"
          }
        },
        "type": "object",
        "required": [
          "approve"
        ],
        "title": "Decision"
      },
      "Document": {
        "properties": {
          "source": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Source"
          },
          "content": {
            "type": "string",
            "maxLength": 200000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "source",
          "content"
        ],
        "title": "Document"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "TaskRequest": {
        "properties": {
          "goal": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 3,
            "title": "Goal"
          },
          "workflow": {
            "type": "string",
            "enum": [
              "auto",
              "business",
              "research",
              "operations"
            ],
            "title": "Workflow",
            "default": "auto"
          },
          "mode": {
            "type": "string",
            "enum": [
              "demo",
              "openai",
              "anthropic"
            ],
            "title": "Mode",
            "default": "demo"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "memory_enabled": {
            "type": "boolean",
            "title": "Memory Enabled",
            "default": true
          },
          "conversation": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "maxItems": 12,
            "title": "Conversation"
          }
        },
        "type": "object",
        "required": [
          "goal"
        ],
        "title": "TaskRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
